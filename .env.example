# InsureRAG — Environment Variables
# Copy to .env and fill in your values. NEVER commit .env to git.

# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_KEYS=dev-key-change-in-prod

# ── Azure OpenAI ─────────────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o-insurerag
AZURE_OPENAI_DEPLOYMENT_EMBED=text-embedding-3-large

# ── Azure AI Search ──────────────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your-search-key
AZURE_SEARCH_INDEX_NAME=insurerag-vectors

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ── MLflow ───────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Azure Blob Storage ────────────────────────────────────────────────
AZURE_STORAGE_CONN_STR=DefaultEndpointsProtocol=https;AccountName=...

# ── Kafka ─────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Risk scoring ──────────────────────────────────────────────────────
XGB_MODEL_PATH=models/xgb_risk_v2.ubj
GNN_MODEL_PATH=models/gnn_fraud_v1.pt
ENSEMBLE_WEIGHTS=[0.4,0.35,0.25]
